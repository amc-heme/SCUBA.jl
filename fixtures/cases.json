{
  "_comment": "Golden-file cases run against SCUBA R 1.2.2 on the AML fixtures. `vars` is given per object form because keys differ (Seurat rna_/ab_/UMAP_, SCE RNA_/AB_/UMAP_, AnnData X_/protein_/X_umap_). `legacy_divergence` marks cases where SCUBA.jl intentionally normalises R behaviour; the Julia test then asserts the documented behaviour instead of the golden.",
  "forms": ["seurat", "sce"],
  "cases": [
    {"id": "basic_mixed", "fn": "fetch_data",
     "vars": {"seurat": ["rna_GAPDH", "ab_CD117-AB", "UMAP_1", "UMAP_2", "nCount_RNA", "condensed_cell_type", "Batch"],
              "sce":    ["RNA_GAPDH", "AB_CD117-AB", "UMAP_1", "UMAP_2", "nCount_RNA", "condensed_cell_type", "Batch"],
              "h5ad":   ["X_GAPDH", "protein_CD117-AB", "X_umap_1", "X_umap_2", "nCount_RNA", "condensed_cell_type", "Batch"]},
     "expect": {"warning": null, "error": null}},
    {"id": "unkeyed_main_and_metadata", "fn": "fetch_data",
     "vars": {"seurat": ["GAPDH", "MEIS1", "nCount_RNA"], "sce": ["GAPDH", "MEIS1", "nCount_RNA"], "h5ad": ["GAPDH", "MEIS1", "nCount_RNA"]},
     "expect": {"warning": null, "error": null}},
    {"id": "unkeyed_alt_feature", "fn": "fetch_data",
     "vars": {"seurat": ["CD11a-AB"], "sce": ["CD11a-AB"], "h5ad": ["CD11a-AB"]},
     "expect": {"warning": "CD11a-AB", "error": null},
     "julia_output_names": {"sce": ["AB_CD11a-AB"], "h5ad": ["protein_CD11a-AB"]}},
    {"id": "partial_missing", "fn": "fetch_data",
     "vars": {"seurat": ["rna_GAPDH", "nonsense", "rna_MESS1", "ab_CD1110-AB", "UMAP_11"],
              "sce":    ["RNA_GAPDH", "nonsense", "RNA_MESS1", "AB_CD1110-AB", "UMAP_11"],
              "h5ad":   ["X_GAPDH", "nonsense", "X_MESS1", "protein_CD1110-AB", "X_umap_11"]},
     "expect": {"warning": "not found", "error": null}},
    {"id": "all_missing", "fn": "fetch_data",
     "vars": {"seurat": ["ab_CD900"], "sce": ["AB_CD900"], "h5ad": ["protein_CD900"]},
     "expect": {"warning": null, "error": "None of the requested variables were found"}},
    {"id": "duplicates_literal", "fn": "fetch_data",
     "vars": {"seurat": ["rna_GAPDH", "rna_GAPDH", "rna_MEIS1", "rna_MEIS1"], "sce": ["RNA_GAPDH", "RNA_GAPDH", "RNA_MEIS1", "RNA_MEIS1"], "h5ad": ["X_GAPDH", "X_GAPDH", "X_MEIS1", "X_MEIS1"]},
     "expect": {"warning": "duplicates", "error": null},
     "legacy_divergence": {"seurat": "SeuratObject::FetchData does not warn on duplicates"}},
    {"id": "duplicates_key_equivalent", "fn": "fetch_data",
     "vars": {"seurat": ["rna_GAPDH", "GAPDH", "rna_MEIS1", "MEIS1"], "sce": ["RNA_GAPDH", "GAPDH", "RNA_MEIS1", "MEIS1"], "h5ad": ["X_GAPDH", "GAPDH", "X_MEIS1", "MEIS1"]},
     "expect": {"warning": "duplicate", "error": null},
     "legacy_divergence": {"seurat": "SeuratObject::FetchData returns both spellings"}},
    {"id": "counts_layer", "fn": "fetch_data", "layer": {"seurat": "counts", "sce": "counts", "h5ad": "counts"},
     "vars": {"seurat": ["rna_GAPDH", "rna_UNG"], "sce": ["RNA_GAPDH", "RNA_UNG"], "h5ad": ["X_GAPDH", "X_UNG"]},
     "expect": {"warning": null, "error": null}},
    {"id": "cells_subset", "fn": "fetch_data", "cells": "first20_reversed",
     "vars": {"seurat": ["rna_GAPDH", "UMAP_1", "Batch"], "sce": ["RNA_GAPDH", "UMAP_1", "Batch"], "h5ad": ["X_GAPDH", "X_umap_1", "Batch"]},
     "expect": {"warning": null, "error": null}},
    {"id": "reduction_default", "fn": "fetch_reduction", "expect": {"warning": null, "error": null}},
    {"id": "metadata_full", "fn": "fetch_metadata_full", "expect": {"warning": null, "error": null}},
    {"id": "metadata_vars", "fn": "fetch_metadata", "vars": {"seurat": ["nCount_RNA", "ct", "prop"], "sce": ["nCount_RNA", "ct", "prop"], "h5ad": ["nCount_RNA", "ct", "prop"]},
     "expect": {"warning": null, "error": null}},
    {"id": "metadata_missing", "fn": "fetch_metadata", "vars": {"seurat": ["nCount_RNA", "nonsense"], "sce": ["nCount_RNA", "nonsense"], "h5ad": ["nCount_RNA", "nonsense"]},
     "expect": {"warning": null, "error": "."}},
    {"id": "cells_by_batch", "fn": "fetch_cells", "meta_var": "Batch", "meta_levels": ["PBMC_200AB"], "expect": {"warning": null, "error": null}},
    {"id": "cells_numeric_var", "fn": "fetch_cells", "meta_var": "nCount_RNA", "meta_levels": [1], "expect": {"warning": null, "error": "categorical"}},
    {"id": "unique_cell_types", "fn": "unique_values", "var": "condensed_cell_type", "expect": {"warning": null, "error": null}},
    {"id": "meta_varnames", "fn": "meta_varnames", "expect": {"warning": null, "error": null}}
  ]
}
